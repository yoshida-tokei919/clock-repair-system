generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// 1. User & Customer Management
model Admin {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Customer {
  id           Int      @id @default(autoincrement())
  type         String   // 'individual', 'business'
  rank         Int      @default(1) // 1 to 5
  name         String
  kana         String?
  companyName  String?
  zipCode      String?
  address      String?
  phone        String?
  email        String?
  lineId       String?
  passwordHash String?
  createdAt    DateTime @default(now())
  
  // Partner Extensions
  isPartner    Boolean  @default(false)
  prefix       String?  // e.g. "T", "JK"
  currentSeq   Int      @default(0) // Last issued sequence (e.g. 100)
  
  // Document Sequences
  seqEstimate  Int      @default(0)
  seqDelivery  Int      @default(0)
  seqInvoice   Int      @default(0)
  seqWarranty  Int      @default(0)

  watches           Watch[]
  repairs           Repair[]
  deliveryNotes     DeliveryNote[]
  invoices          Invoice[]
  estimateDocuments EstimateDocument[]
  estimatePdfFiles  EstimatePdfFile[]
  invoicePdfFiles   InvoicePdfFile[]
  warranties        Warranty[]
}

// 2. Watch Metadata (Smart Input)
model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @unique // Legacy support (Internal ID or English)
  nameEn      String?   @map("name_en") // English (e.g. ROLEX)
  nameJp      String    @map("name_jp") // Japanese (e.g. ロレックス)
  kana        String?
  initialChar String?
  
  models      Model[]
  calibers    Caliber[]
  watches     Watch[]
  movementMakerRepairs     Repair[] @relation("RepairMovementMaker")
  baseMovementMakerRepairs Repair[] @relation("RepairBaseMovementMaker")
  // PartsMaster への複数FK対応：named relation
  parts              PartsMaster[] @relation("PartsBrand")
  movementMakerParts PartsMaster[] @relation("PartsMovementMaker")
  baseMakerParts     PartsMaster[] @relation("PartsBaseMaker")
}

model Model {
  id        Int     @id @default(autoincrement())
  brandId   Int
  name      String  // Legacy
  nameEn    String? @map("name_en")
  nameJp    String  @map("name_jp")
  
  brand     Brand   @relation(fields: [brandId], references: [id])
  references WatchReference[]
  watches   Watch[]
  parts     PartsMaster[]
}

model WatchReference {
  id        Int      @id @default(autoincrement())
  modelId   Int
  name      String   // e.g. 16233
  caliberId Int?
  
  model     Model    @relation(fields: [modelId], references: [id])
  caliber   Caliber? @relation(fields: [caliberId], references: [id])
  watches   Watch[]
}

model Caliber {
  id                  Int     @id @default(autoincrement())
  brandId             Int?
  name                String
  nameEn              String? @map("name_en")
  nameJp              String? @map("name_jp")
  movementType        String? // 'quartz', 'mechanical_simple', 'mechanical_chrono'
  standardWorkMinutes Int     @default(60)
  
  brand      Brand?  @relation(fields: [brandId], references: [id])
  references WatchReference[]
  watches    Watch[]
  movementCaliberRepairs     Repair[] @relation("RepairMovementCaliber")
  baseMovementCaliberRepairs Repair[] @relation("RepairBaseMovementCaliber")
  // PartsMaster への複数FK対応：named relation
  parts            PartsMaster[] @relation("PartsCaliber")
  baseCaliberParts PartsMaster[] @relation("PartsBaseCaliber")
}

// 3. Repair & Watch
model Watch {
  id           Int      @id @default(autoincrement())
  brandId      Int
  modelId      Int
  referenceId  Int?
  caliberId    Int?
  serialNumber String? // Optional for vintage/unknown
  customerId   Int
  
  brand       Brand    @relation(fields: [brandId], references: [id])
  model       Model    @relation(fields: [modelId], references: [id])
  reference   WatchReference? @relation(fields: [referenceId], references: [id])
  caliber     Caliber? @relation(fields: [caliberId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  repairs     Repair[]

  accessories  String?  // JSON or comma-separated list of accessories (Box, Warranty, etc.)
  
  // Fast Search Indexes
  @@index([brandId, serialNumber]) // Replaced unique constraint with index
  @@index([serialNumber])
  @@index([brandId, modelId])
}

model Repair {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @default(uuid())
  publicToken          String?   @unique
  publicTokenCreatedAt DateTime?
  inquiryNumber        String    @unique // T-001
  customerId           Int
  watchId              Int
  movementMakerId      Int?
  movementCaliberId    Int?
  baseMovementMakerId  Int?
  baseMovementCaliberId Int?
  partnerRef           String?   // Manual Partner Mgmt No
  accessories          String?   // JSON or CSV of checked items
  
  receptionDate        DateTime  @default(now())
  status               String    // 'reception', 'diagnosing', etc.
  approvalStatus       String    @default("pending")
  approvalDate         DateTime?
  
  // Scheduling & Priority Logic
  priorityScore        Int       @default(0)
  scheduledDate        DateTime?
  estimatedWorkMinutes Int       @default(0)
  
  workSummary          String?
  internalNotes        String?
  customerNote         String?
  // SEO Flags
  isPublicB2C          Boolean   @default(false)
  isPublicB2B          Boolean   @default(false)
  publicTitle          String?
  publicDescription    String?
  endUserName          String?   // B2B End User Name
  
  
  deliveryDateExpected DateTime?
  deliveryDateActual   DateTime?
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id])
  watch    Watch             @relation(fields: [watchId], references: [id])
  movementMaker        Brand?   @relation("RepairMovementMaker", fields: [movementMakerId], references: [id])
  movementCaliber      Caliber? @relation("RepairMovementCaliber", fields: [movementCaliberId], references: [id])
  baseMovementMaker    Brand?   @relation("RepairBaseMovementMaker", fields: [baseMovementMakerId], references: [id])
  baseMovementCaliber  Caliber? @relation("RepairBaseMovementCaliber", fields: [baseMovementCaliberId], references: [id])
  logs          RepairStatusLog[]
  customerMessages RepairCustomerMessage[]
  photos        RepairPhoto[]
  estimate      Estimate?
  repairLineItems RepairLineItem[]
  orderRequests OrderRequest[]
  publicCases   PublicCase[]
  
  deliveryNoteId Int?
  deliveryNote   DeliveryNote? @relation(fields: [deliveryNoteId], references: [id])

  invoiceId      Int?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])

  estimateDocumentId Int?
  estimateDocument   EstimateDocument? @relation(fields: [estimateDocumentId], references: [id])

  warrantyId Int?
  warranty   Warranty? @relation(fields: [warrantyId], references: [id])
}

model RepairStatusLog {
  id        Int      @id @default(autoincrement())
  repairId  Int
  status    String
  changedAt DateTime @default(now())
  changedBy Int?     // Admin ID
  
  repair    Repair   @relation(fields: [repairId], references: [id])
}

model RepairCustomerMessage {
  id        Int       @id @default(autoincrement())
  repairId  Int
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  senderType String    @default("partner")

  repair    Repair    @relation(fields: [repairId], references: [id])

  @@index([repairId, readAt])
}

// 4. Photos
model RepairPhoto {
  id         Int      @id @default(autoincrement())
  repairId   Int
  category   String
  storageKey String
  fileName   String?
  mimeType   String?
  createdAt  DateTime @default(now())
  
  repair     Repair   @relation(fields: [repairId], references: [id])
}

// 5. Accounting
model PricingRule {
  id                Int     @id @default(autoincrement())
  brandId           Int?
  modelId           Int?
  caliberId         Int?
  customerType      String?
  minPrice          Int
  maxPrice          Int
  suggestedWorkName String
  notes             String?

  repairLineItems RepairLineItem[]
}

model Estimate {
  id             Int      @id @default(autoincrement())
  repairId       Int      @unique
  version        Int      @default(1)
  issuedDate     DateTime @default(now())
  
  technicalFee   Int      @default(0)
  mechanicCost   Int      @default(0)
  partsTotal     Int      @default(0)
  discountAmount Int      @default(0)
  shipping       Int      @default(0)
  taxAmount      Int      @default(0)
  totalAmount    Int      @default(0)
  isActive       Boolean  @default(true)
  
  repair         Repair         @relation(fields: [repairId], references: [id])
  items          EstimateItem[]
}

model EstimateItem {
  id         Int    @id @default(autoincrement())
  estimateId Int
  itemName   String
  quantity   Int    @default(1)
  unitPrice  Int
  type       String // 'part', 'labor'
  
  // For Parts Management (Phase 3)
  orderStatus String?  @default("pending") // 'pending', 'ordered', 'received'
  orderedAt   DateTime?
  
  partsMasterId Int?
  partsMaster   PartsMaster? @relation(fields: [partsMasterId], references: [id])

  createdAt   DateTime @default(now())

  estimate   Estimate @relation(fields: [estimateId], references: [id])
}

enum RepairLineItemType {
  LABOR
  PART
}

model RepairLineItem {
  id       Int    @id @default(autoincrement())
  repairId Int
  repair   Repair @relation(fields: [repairId], references: [id], onDelete: Cascade)

  lineType RepairLineItemType

  partsMasterId Int?
  partsMaster   PartsMaster? @relation(fields: [partsMasterId], references: [id])

  pricingRuleId Int?
  pricingRule   PricingRule? @relation(fields: [pricingRuleId], references: [id])

  relatedWorkLineItemId Int?
  relatedWorkLineItem   RepairLineItem?  @relation("RepairLineItemRelatedWork", fields: [relatedWorkLineItemId], references: [id])
  relatedPartLineItems  RepairLineItem[] @relation("RepairLineItemRelatedWork")

  itemNameSnapshot            String
  estimateDisplayNameSnapshot String?
  b2bDisplayNameSnapshot      String?
  b2cDisplayNameSnapshot      String?

  gradeNameSnapshot       String?
  notesForCustomerSnapshot String?

  quantity  Int @default(1)
  unitPrice Int @default(0)
  amount    Int @default(0)

  showPriceB2b Boolean @default(false)
  showPriceB2c Boolean @default(false)

  sortOrder Int @default(0)

  internalMemo String?
  customerMemo String?
  publicMemo   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repairId])
  @@index([lineType])
  @@index([partsMasterId])
  @@index([pricingRuleId])
  @@index([relatedWorkLineItemId])
  @@index([repairId, sortOrder])
  @@index([repairId, lineType])
}

// 6. Parts

// §13 購入店マスタ
model Supplier {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  url      String?
  isOnline Boolean @default(true) // true: オンライン店 / false: 実店舗
  notes    String?

  parts         PartsMaster[]
  orderRequests OrderRequest[]
}

// §13 部品マスタ（内装・外装統合）
// Standard part category master for selectable part categories.
model PartCategoryMaster {
  id        String   @id @default(cuid())
  key       String   @unique
  partType  String
  nameJa    String
  nameEn    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  partNames PartNameMaster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partType])
  @@index([partType, sortOrder])
}

// Standard part name master. Prices, stock, suppliers, and refs belong to PartsMaster.
model PartNameMaster {
  id         String   @id @default(cuid())
  key        String   @unique
  categoryId String
  partType   String

  nameJa     String
  nameEn     String?
  displayJa  String?
  displayEn  String?

  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)

  category   PartCategoryMaster @relation(fields: [categoryId], references: [id])
  parts      PartsMaster[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([partType])
  @@index([categoryId])
  @@index([partType, categoryId])
  @@index([partType, sortOrder])
}

// Grade master. Genuine/FIT/custom-fit can imply different price, quality, supplier, and stock.
model PartGradeMaster {
  id        String   @id @default(cuid())
  key       String   @unique
  nameJa    String
  nameEn    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  parts     PartsMaster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model PartsMaster {
  id              Int     @id @default(autoincrement())
  standardPartNameId String?
  gradeId            String?

  // ── 区分 ──────────────────────────────────
  partType        String? // 'interior'（内装）| 'exterior'（外装）/ nullable for existing rows
  category        String  // 'internal', 'external', 'generic'（既存互換）
  subcategory     String? // 内装サブカテゴリ: '地板/受け'|'輪列'|'巻上'|'調速'|'裏まわり'

  // ── 外装：時計情報 ────────────────────────
  brandId         Int?
  modelId         Int?
  watchRefs       String? // 対応Ref（カンマ区切り）

  // ── 内装：ムーブメント情報 ─────────────────
  caliberId       Int?    // Cal.
  baseCaliberId   Int?    // ベースムーブメントCal.
  movementMakerId Int?    // ムーブメント製造元（brandIdと異なる場合）
  baseMakerId     Int?    // ベースムーブメント製造元

  // ── 部品情報 ──────────────────────────────
  name            String  // Legacy
  nameEn          String? @map("name_en")
  nameJp          String  @map("name_jp")
  partRefs        String? // 部品Ref（カンマ区切り複数対応）
  cousinsNumber   String? // cousins番号
  grade           String? // '純正' | 'FIT' | '合わせ'
  size            String? // サイズ（外装用・カテゴリごとテンプレ）
  photoKey        String? // 画像キー

  // ── 備考 ──────────────────────────────────
  notes1          String? @map("notes") // 備考1（既存DBカラム名保持）
  notes2          String? // 備考2

  // ── 価格情報 ──────────────────────────────
  costCurrency    String  @default("JPY") // ¥ / £ / $ / €
  costOriginal    Float   @default(0)     // 外貨建て仕入原価
  latestCostYen   Int     @default(0)     // 円換算仕入価格
  markupRate      Float   @default(1.3)   // 掛け率 1.1〜2.0
  retailPrice     Int     @default(0)     // 上代（500円単位切り上げ）

  // ── 在庫情報 ──────────────────────────────
  stockQuantity        Int     @default(0)
  minStockAlert        Int     @default(0)     // 最小在庫数アラートしきい値
  minStockAlertEnabled Boolean @default(false) // アラートON/OFF
  location             String? // 保管場所（例：A-3-2）
  supplierId           Int?    // FK → Supplier

  // ── Relations ────────────────────────────
  brand         Brand?    @relation("PartsBrand",         fields: [brandId],         references: [id])
  model         Model?    @relation(                      fields: [modelId],          references: [id])
  caliber       Caliber?  @relation("PartsCaliber",       fields: [caliberId],        references: [id])
  baseCaliber   Caliber?  @relation("PartsBaseCaliber",   fields: [baseCaliberId],    references: [id])
  movementMaker Brand?    @relation("PartsMovementMaker", fields: [movementMakerId],  references: [id])
  baseMaker     Brand?    @relation("PartsBaseMaker",     fields: [baseMakerId],      references: [id])
  supplier      Supplier? @relation(                      fields: [supplierId],        references: [id])
  standardPartName PartNameMaster?  @relation(fields: [standardPartNameId], references: [id])
  gradeMaster      PartGradeMaster? @relation(fields: [gradeId],            references: [id])
  orderRequests OrderRequest[]
  estimateItems EstimateItem[]
  repairLineItems RepairLineItem[]

  @@index([standardPartNameId])
  @@index([gradeId])
}

// 7. Documents (Bulk Generation)
model DeliveryNote {
  id           Int      @id @default(autoincrement())
  slipNumber   String   @unique // e.g. TD-001
  issuedDate   DateTime @default(now())
  
  customerId   Int
  customer     Customer @relation(fields: [customerId], references: [id])
  
  repairs      Repair[]
  
  totalAmount  Int      @default(0) // Cache for speed
  taxAmount    Int      @default(0)
}

model Invoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique // e.g. TI-001
  issuedDate    DateTime @default(now())
  billingMonth  String?
  publicToken   String?  @unique
  publicTokenCreatedAt DateTime?
  currentPdfFileId Int? @unique
  
  customerId    Int
  customer      Customer @relation(fields: [customerId], references: [id])
  
  repairs       Repair[]
  pdfFiles      InvoicePdfFile[] @relation("InvoicePdfFiles")
  currentPdfFile InvoicePdfFile? @relation("CurrentInvoicePdfFile", fields: [currentPdfFileId], references: [id], onDelete: SetNull)
  
  totalAmount   Int      @default(0)
  taxAmount     Int      @default(0)
  status        String   @default("issued") // issued, paid
  paymentDueDate DateTime?
  sentAt        DateTime?
}



model EstimateDocument {
  id              Int      @id @default(autoincrement())
  estimateNumber  String   @unique // e.g. TE-001
  issuedDate      DateTime @default(now())
  publicToken     String?  @unique
  publicTokenCreatedAt DateTime?
  currentPdfFileId Int?    @unique
  
  customerId      Int
  customer        Customer @relation(fields: [customerId], references: [id])

  repairs         Repair[]
  pdfFiles        EstimatePdfFile[] @relation("EstimateDocumentPdfFiles")
  currentPdfFile  EstimatePdfFile?  @relation("CurrentEstimatePdfFile", fields: [currentPdfFileId], references: [id], onDelete: SetNull)

  totalAmount     Int      @default(0)
  taxAmount       Int      @default(0)
}

model EstimatePdfFile {
  id                 Int              @id @default(autoincrement())
  estimateDocumentId Int
  customerId         Int?
  storageKey         String
  fileName           String
  contentType        String           @default("application/pdf")
  fileSize           Int?
  hash               String?
  version            Int
  status             String           @default("current")
  generatedAt        DateTime         @default(now())
  generatedBy        String?
  sentAt             DateTime?
  approvedAt         DateTime?
  supersededAt       DateTime?

  estimateDocument   EstimateDocument  @relation("EstimateDocumentPdfFiles", fields: [estimateDocumentId], references: [id], onDelete: Cascade)
  currentForDocument EstimateDocument? @relation("CurrentEstimatePdfFile")
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([estimateDocumentId])
  @@index([customerId])
  @@index([status])
  @@unique([estimateDocumentId, version])
}

model InvoicePdfFile {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice Invoice @relation("InvoicePdfFiles", fields: [invoiceId], references: [id], onDelete: Cascade)

  currentForInvoice Invoice? @relation("CurrentInvoicePdfFile")

  customerId Int?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  storageKey String
  fileName String
  contentType String @default("application/pdf")
  fileSize Int?
  hash String?

  version Int
  status String @default("draft")

  generatedAt DateTime @default(now())
  generatedBy String?

  sentAt DateTime?
  paidAt DateTime?
  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([invoiceId, version])
  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
}

model Warranty {
  id              Int      @id @default(autoincrement())
  warrantyNumber  String   @unique // e.g. TW-001
  issuedDate      DateTime @default(now())
  guaranteeStart  DateTime
  guaranteeEnd    DateTime

  customerId      Int
  customer        Customer @relation(fields: [customerId], references: [id])

  repairs         Repair[]
}

// §21 発注リスト
model OrderRequest {
  id            Int      @id @default(autoincrement())

  // 部品情報
  partsMasterId Int?
  partsMaster   PartsMaster? @relation(fields: [partsMasterId], references: [id])
  partNameJp    String
  partNameEn    String?
  partRefs      String?
  cousinsNumber String?

  // 発注情報
  quantity      Int      @default(1)
  supplierId    Int?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])

  // ステータス
  // pending（未発注）/ ordered（注文済み）/ received（入荷済み）/ cancelled（キャンセル）
  status        String   @default("pending")

  // 検索ワード（自動生成）
  searchWordJp  String?
  searchWordEn  String?

  // 関連カルテ
  repairId      Int?
  repair        Repair?  @relation(fields: [repairId], references: [id])

  // メモ・日時
  notes         String?
  orderedAt     DateTime?
  receivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum PublicCaseSourceType {
  FMP
  WEB_APP
}

enum PublicCasePublishStatus {
  HIDDEN
  READY
  PUBLISHED
  ARCHIVED
}

enum PublicCaseReviewStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum PublicCaseWarningSeverity {
  CRITICAL
  REVIEW
  INFO
}

model PublicCase {
  id             Int                  @id @default(autoincrement())
  sourceType     PublicCaseSourceType
  sourceRepairId String?
  repairId       Int?

  receivedDate DateTime?
  brandName    String?
  brandNameKana String?
  brandDisplayName String?
  modelName    String?
  ref          String?
  caliber      String?
  searchText   String?

  reviewStatus     PublicCaseReviewStatus @default(DRAFT)
  b2bPublishStatus PublicCasePublishStatus @default(HIDDEN)
  b2cPublishStatus PublicCasePublishStatus @default(HIDDEN)
  b2bPublishedAt   DateTime?
  b2cPublishedAt   DateTime?

  b2bTitle   String?
  b2cTitle   String?
  b2bSummary Json?
  b2cSummary Json?
  publicTags Json?

  showPriceB2b       Boolean @default(true)
  showPriceB2c       Boolean @default(false)
  internalLaborTotal Int?
  externalLaborTotal Int?
  outsourcedTotal    Int?
  partsTotal         Int?
  totalAmount        Int?

  warnings       Json?
  excludeReasons Json?
  sourceSnapshot Json?

  repair       Repair?              @relation(fields: [repairId], references: [id], onDelete: SetNull)
  workItems    PublicCaseWorkItem[]
  partItems    PublicCasePartItem[]
  images       PublicCaseImage[]
  warningItems PublicCaseWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceType, sourceRepairId])
  @@index([repairId])
  @@index([brandName])
  @@index([brandNameKana])
  @@index([modelName])
  @@index([ref])
  @@index([caliber])
  @@index([b2bPublishStatus])
  @@index([b2cPublishStatus])
  @@index([reviewStatus])
}

model PublicCaseWorkItem {
  id           Int @id @default(autoincrement())
  publicCaseId Int

  sourceArea           String
  sourceSlot           Int?
  sourceText           String
  normalizedSourceText String

  isRuleMatched Boolean                @default(false)
  isPublishable Boolean                @default(false)
  reviewStatus  PublicCaseReviewStatus @default(DRAFT)
  excludeReason String?

  normalizedWorkName String?
  b2bDisplayName     String?
  b2cDisplayName     String?
  laborPrice         Int?
  showPriceB2b       Boolean @default(true)
  showPriceB2c       Boolean @default(false)

  category     String?
  partName     String?
  action       String?
  actionDetail String?
  attributes   Json?
  ruleSnapshot Json?

  sortOrder Int @default(0)

  publicCase PublicCase           @relation(fields: [publicCaseId], references: [id], onDelete: Cascade)
  partItems  PublicCasePartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicCaseId])
  @@index([sourceArea])
  @@index([normalizedSourceText])
  @@index([isPublishable])
}

model PublicCasePartItem {
  id                Int  @id @default(autoincrement())
  publicCaseId      Int
  relatedWorkItemId Int?

  sourceArea           String
  sourceSlot           Int?
  sourceText           String
  normalizedSourceText String
  displayName          String?
  price                Int?

  showPriceB2b   Boolean                @default(true)
  showPriceB2c   Boolean                @default(false)
  relationStatus String                 @default("UNLINKED")
  reviewStatus   PublicCaseReviewStatus @default(DRAFT)
  excludeReason  String?
  metadata       Json?

  sortOrder Int @default(0)

  publicCase      PublicCase          @relation(fields: [publicCaseId], references: [id], onDelete: Cascade)
  relatedWorkItem PublicCaseWorkItem? @relation(fields: [relatedWorkItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicCaseId])
  @@index([relatedWorkItemId])
  @@index([sourceArea])
}

model PublicCaseImage {
  id           Int @id @default(autoincrement())
  publicCaseId Int

  storagePath  String?
  url          String?
  altText      String?
  caption      String?
  imageRole    String?
  isPrimary    Boolean                @default(false)
  reviewStatus PublicCaseReviewStatus @default(DRAFT)
  sortOrder    Int                    @default(0)

  publicCase PublicCase @relation(fields: [publicCaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicCaseId])
}

model PublicCaseWarning {
  id           Int @id @default(autoincrement())
  publicCaseId Int

  code     String
  severity PublicCaseWarningSeverity
  message  String?
  target   String?
  metadata Json?

  publicCase PublicCase @relation(fields: [publicCaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([publicCaseId])
  @@index([code])
  @@index([severity])
}
