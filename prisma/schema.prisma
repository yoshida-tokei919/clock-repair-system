  publicCaseId Int

  code     String
  severity PublicCaseWarningSeverity
  message  String?
  target   String?
  metadata Json?

  publicCase PublicCase @relation(fields: [publicCaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([publicCaseId])
  @@index([code])
  @@index([severity])
}
