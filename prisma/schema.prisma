  storagePath  String?
  url          String?
  altText      String?
  caption      String?
  imageRole    String?
  isPrimary    Boolean                @default(false)
  reviewStatus PublicCaseReviewStatus @default(DRAFT)
  sortOrder    Int                    @default(0)

  publicCase PublicCase @relation(fields: [publicCaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicCaseId])
}

model PublicCaseWarning {
