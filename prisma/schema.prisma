generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// 1. User & Customer Management
model Admin {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Customer {
  id           Int      @id @default(autoincrement())
  type         String   // 'individual', 'business'
  rank         Int      @default(1) // 1 to 5
  name         String
  kana         String?
  companyName  String?
  zipCode      String?
  prefecture   String?
  city         String?
  street       String?
  building     String?
  address      String?
  phone        String?
  email        String?
  lineId       String?
  passwordHash String?
  createdAt    DateTime @default(now())
  
  // Partner Extensions
  isPartner    Boolean  @default(false)
  prefix       String?  // e.g. "T", "JK"
  currentSeq   Int      @default(0) // Last issued sequence (e.g. 100)
  
  // Document Sequences
  seqEstimate  Int      @default(0)
  seqDelivery  Int      @default(0)
  seqInvoice   Int      @default(0)
  seqWarranty  Int      @default(0)

  watches           Watch[]
  repairs           Repair[]
  deliveryNotes     DeliveryNote[]
  invoices          Invoice[]
  estimateDocuments EstimateDocument[]
  estimatePdfFiles  EstimatePdfFile[]
  invoicePdfFiles   InvoicePdfFile[]
  payments          Payment[]
  warranties        Warranty[]
  lineUsers         LineUser[]
  repairIntakeInvites RepairIntakeInvite[]
}

// LINE webhook users are retained before, and independently from, any Customer UI link.
model LineUser {
  id               Int       @id @default(autoincrement())
  lineUserId       String    @unique
  displayName      String?
  firstReceivedAt  DateTime
  lastReceivedAt   DateTime
  lastEventType    String
  linkedCustomerId Int?
  linkedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  linkedCustomer Customer? @relation(fields: [linkedCustomerId], references: [id], onDelete: SetNull)
  repairIntakeInvites RepairIntakeInvite[]
  inquiries           Inquiry[]
  inquiryMessages     InquiryMessage[]

  @@index([linkedCustomerId])
  @@index([lastReceivedAt])
}

// LINE相談の親レコード。Repair の作成・変換は後続Taskで扱う。
enum LineWebhookInboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

model LineWebhookInbox {
  id             Int                    @id @default(autoincrement())
  webhookEventId String                 @unique
  eventType      String
  rawEvent       Json
  receivedAt     DateTime
  status         LineWebhookInboxStatus @default(RECEIVED)
  attemptCount   Int                    @default(0)
  lastAttemptAt  DateTime?
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, lastAttemptAt])
}

enum SlackNotificationTarget {
  REPAIR_INBOX
  REPAIR_ERRORS
}

enum SlackNotificationKind {
  NEW_INQUIRY
  IMAGE_ADDED
  INQUIRY_UPDATED
  NEEDS_REVIEW
  INBOX_PROCESSING_FAILED
}

enum SlackNotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// Durable internal-notification queue. Slack delivery is intentionally owned by n8n.
model SlackNotificationOutbox {
  id              Int                          @id @default(autoincrement())
  target          SlackNotificationTarget
  kind            SlackNotificationKind
  dedupeKey       String                       @unique
  status          SlackNotificationOutboxStatus @default(PENDING)
  attemptCount    Int                          @default(0)
  lastAttemptAt   DateTime?
  processingToken String?
  sentAt          DateTime?
  lastError       String?
  text            String
  inquiryId       Int?
  inboxId         Int?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  inquiry Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  @@index([status, lastAttemptAt])
  @@index([inquiryId])
  @@index([inboxId])
}

enum InquiryStatus {
  OPEN
  AI_PENDING
  AI_PROCESSED
  NEEDS_REVIEW
  WAITING_CUSTOMER
  READY_FOR_INTAKE
  CLOSED
}

enum InquiryMessageDirection {
  INBOUND
  OUTBOUND
}

enum InquiryMessageType {
  TEXT
  IMAGE
  FILE
  OTHER
}

enum InquiryFileStatus {
  PENDING
  STORED
  FAILED
}

enum InquiryAiAnalysisStatus {
  PENDING
  COMPLETED
  NEEDS_REVIEW
  FAILED
}

enum InquiryAiConfidence {
  LOW
  MEDIUM
  HIGH
}

enum InquiryAiReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InquiryAiCandidateField {
  BRAND
  MODEL
  PRODUCT_REF
  CASE_REF
  CALIBER
  BASE_CALIBER
  MOVEMENT_TYPE
  ERA
}

enum InquiryAiSourceType {
  CUSTOMER_STATED
  IMAGE_OBSERVED
  WEB_INFERRED
  AI_INFERRED
  TECHNICIAN_CONFIRMED
}

enum InquiryWatchField {
  BRAND
  MODEL
  PRODUCT_REF
  CASE_REF
  CALIBER
  BASE_CALIBER
  MOVEMENT_TYPE
  ERA
}

enum InquiryWatchFieldValueSource {
  AI_CANDIDATE
  MANUAL
}

enum InquiryWatchFieldConfirmationStatus {
  PENDING
  CONFIRMED
}

enum InquiryWatchDecision {
  PENDING
  REQUESTED
  DECLINED
}

model Inquiry {
  id              Int           @id @default(autoincrement())
  lineUserId      Int
  status          InquiryStatus @default(OPEN)
  firstReceivedAt DateTime
  lastReceivedAt  DateTime
  conversationSummary String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lineUser LineUser         @relation(fields: [lineUserId], references: [id], onDelete: Restrict)
  messages InquiryMessage[]
  files    InquiryFile[]
  analyses InquiryAiAnalysis[]
  reviewWatches InquiryWatch[]
  repairIntakeInvites RepairIntakeInvite[]
  slackNotifications SlackNotificationOutbox[]

  @@index([lineUserId, status])
  @@index([lineUserId, lastReceivedAt])
}

// LINEの受信・送信履歴。externalMessageId はLINE message IDの冪等キー。
model InquiryMessage {
  id                Int                     @id @default(autoincrement())
  inquiryId         Int
  lineUserId        Int
  externalMessageId String                  @unique
  direction         InquiryMessageDirection
  messageType       InquiryMessageType
  body              String?
  receivedAt        DateTime?
  sentAt            DateTime?
  status            String                  @default("received")
  createdAt         DateTime                @default(now())

  inquiry  Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  lineUser LineUser      @relation(fields: [lineUserId], references: [id], onDelete: Restrict)
  files    InquiryFile[]

  @@index([inquiryId, createdAt])
  @@index([lineUserId, createdAt])
}

model InquiryFile {
  id               Int               @id @default(autoincrement())
  inquiryId        Int
  inquiryMessageId Int?              @unique
  provider         String            @default("LINE")
  providerFileId   String?
  bucket           String
  objectKey        String            @unique
  mimeType         String?
  fileSize         Int?
  width            Int?
  height           Int?
  uploadStatus     InquiryFileStatus @default(PENDING)
  lastError        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  inquiry        Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  inquiryMessage InquiryMessage? @relation(fields: [inquiryMessageId], references: [id], onDelete: SetNull)

  @@unique([provider, providerFileId])
  @@index([inquiryId, createdAt])
  @@index([uploadStatus])
}

model InquiryAiAnalysis {
  id                   Int                     @id @default(autoincrement())
  inquiryId            Int
  status               InquiryAiAnalysisStatus
  idempotencyKey       String                  @unique
  inputFingerprint     String
  modelProvider        String
  modelName            String
  promptVersion        String
  inputSnapshot        Json
  conversationSummary  String?
  watchCount           Int?
  watchCountConfidence InquiryAiConfidence?
  unresolvedPoints     Json?
  errorMessage         String?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  inquiry Inquiry          @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  watches InquiryAiWatch[]

  @@index([inquiryId, createdAt])
  @@index([inquiryId, inputFingerprint])
}

model InquiryAiWatch {
  id                     Int                 @id @default(autoincrement())
  analysisId             Int
  position               Int
  label                  String?
  summary                String?
  segmentationConfidence InquiryAiConfidence?
  faults                 Json?
  requestedWork          Json?
  supplementalFacts      Json?
  missingInformation     Json?
  missingPhotos          Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  analysis   InquiryAiAnalysis    @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  candidates InquiryAiCandidate[]
  reviewWatches InquiryWatch[] @relation("InquiryWatchSourceAiWatch")

  @@unique([analysisId, position])
}

model InquiryAiCandidate {
  id               Int                     @id @default(autoincrement())
  watchId          Int
  field            InquiryAiCandidateField
  rank             Int                     @default(0)
  value            String
  confidence       InquiryAiConfidence?
  evidence         String?
  observedText     String?
  sourceType       InquiryAiSourceType
  sourceMessageIds Json?
  sourceImageIds   Json?
  reviewStatus     InquiryAiReviewStatus   @default(PENDING)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  watch InquiryAiWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  reviewFieldValues InquiryWatchFieldValue[]

  @@index([watchId, field])
  @@index([reviewStatus])
}

// A human-review draft derived from an immutable InquiryAiWatch. It is never a
// formal Watch or Repair and must remain safe to edit while AI snapshots stay
// unchanged.
model InquiryWatch {
  id              Int      @id @default(autoincrement())
  inquiryId       Int
  sourceAiWatchId Int?
  position        Int
  label           String?
  summary         String?
  faults          Json?
  requestedWork   Json?
  supplementalFacts Json?
  missingInformation Json?
  missingPhotos   Json?

  // These optional IDs can only be set by a later human confirmation flow.
  // Creating this draft from AI analysis never creates or updates masters.
  brandId         Int?
  modelId         Int?
  referenceId     Int?
  caseReferenceId Int?
  caliberId       Int?
  baseCaliberId   Int?

  // P3-3 will populate these in the same transaction that creates a formal
  // Watch and Repair. Their one-to-one shape prevents ambiguous promotion.
  promotedWatchId Int?     @unique
  promotedRepairId Int?    @unique
  promotedAt      DateTime?
  decision        InquiryWatchDecision @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inquiry       Inquiry        @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  sourceAiWatch InquiryAiWatch? @relation("InquiryWatchSourceAiWatch", fields: [sourceAiWatchId], references: [id], onDelete: Restrict)
  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  model         Model?         @relation(fields: [modelId], references: [id], onDelete: Restrict)
  reference     WatchReference? @relation("InquiryWatchReference", fields: [referenceId], references: [id], onDelete: Restrict)
  caseReference WatchReference? @relation("InquiryWatchCaseReference", fields: [caseReferenceId], references: [id], onDelete: Restrict)
  caliber       Caliber?       @relation(fields: [caliberId], references: [id], onDelete: Restrict)
  baseCaliber   Caliber?       @relation("InquiryWatchBaseCaliber", fields: [baseCaliberId], references: [id], onDelete: Restrict)
  promotedWatch Watch?         @relation("InquiryWatchPromotedWatch", fields: [promotedWatchId], references: [id], onDelete: Restrict)
  promotedRepair Repair?       @relation("InquiryWatchPromotedRepair", fields: [promotedRepairId], references: [id], onDelete: Restrict)
  fieldValues   InquiryWatchFieldValue[]
  intakeInviteWatches RepairIntakeInviteWatch[]

  @@index([inquiryId, createdAt])
  @@unique([inquiryId, position])
  @@index([inquiryId, position])
  @@index([promotedAt])
  @@index([inquiryId, decision, promotedAt])
}

// One current, editable value per field. The immutable AI candidate remains
// available as provenance; manual values have no AI candidate reference.
model InquiryWatchFieldValue {
  id                  Int                                  @id @default(autoincrement())
  inquiryWatchId      Int
  field               InquiryWatchField
  value               String
  source              InquiryWatchFieldValueSource
  confirmationStatus  InquiryWatchFieldConfirmationStatus @default(PENDING)
  sourceAiCandidateId Int?                                 @unique
  confirmedAt         DateTime?
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt

  inquiryWatch      InquiryWatch       @relation(fields: [inquiryWatchId], references: [id], onDelete: Cascade)
  sourceAiCandidate InquiryAiCandidate? @relation(fields: [sourceAiCandidateId], references: [id], onDelete: Restrict)

  @@unique([inquiryWatchId, field])
  @@index([confirmationStatus])
}

// 2. Watch Metadata (Smart Input)
enum BrandKind {
  NORMAL
  TYPE
  UNKNOWN
}

enum TimepieceType {
  WRISTWATCH
  POCKET_WATCH
  WALL_CLOCK
  TABLE_CLOCK
  OTHER
}

enum WatchDriveType {
  QUARTZ
  MECHANICAL
  UNKNOWN
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @unique // Legacy support (Internal ID or English)
  nameEn      String?   @map("name_en") // English (e.g. ROLEX)
  nameJp      String    @map("name_jp") // Japanese (e.g. ロレックス)
  kana        String?
  initialChar String?
  brandKind       BrandKind @default(NORMAL)
  isWatchBrand    Boolean   @default(true)
  isMovementMaker Boolean   @default(false)
  
  models      Model[]
  calibers    Caliber[]
  watches     Watch[]
  movementMakerRepairs     Repair[] @relation("RepairMovementMaker")
  baseMovementMakerRepairs Repair[] @relation("RepairBaseMovementMaker")
  // PartsMaster への複数FK対応：named relation
  parts              PartsMaster[] @relation("PartsBrand")
  movementMakerParts PartsMaster[] @relation("PartsMovementMaker")
  baseMakerParts     PartsMaster[] @relation("PartsBaseMaker")
  aliases            BrandAlias[]
  inquiryWatches     InquiryWatch[]
}

model BrandAlias {
  id              Int    @id @default(autoincrement())
  brandId         Int
  alias           String
  normalizedAlias String @unique

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

model Model {
  id        Int     @id @default(autoincrement())
  brandId   Int
  name      String  // Legacy
  nameEn    String? @map("name_en")
  nameJp    String  @map("name_jp")
  
  brand     Brand   @relation(fields: [brandId], references: [id])
  references WatchReference[]
  watches   Watch[]
  parts     PartsMaster[]
  inquiryWatches InquiryWatch[]
}

model WatchReference {
  id        Int      @id @default(autoincrement())
  modelId   Int
  name      String   // e.g. 16233
  caliberId Int?
  
  model     Model    @relation(fields: [modelId], references: [id])
  caliber   Caliber? @relation(fields: [caliberId], references: [id])
  watches   Watch[]
  caseReferenceWatches Watch[] @relation("WatchCaseReference")
  inquiryReferenceWatches InquiryWatch[] @relation("InquiryWatchReference")
  inquiryCaseReferenceWatches InquiryWatch[] @relation("InquiryWatchCaseReference")
}

model Caliber {
  id                  Int     @id @default(autoincrement())
  brandId             Int?
  name                String
  nameEn              String? @map("name_en")
  nameJp              String? @map("name_jp")
  movementType        String? // 'quartz', 'mechanical_simple', 'mechanical_chrono'
  standardWorkMinutes Int     @default(60)
  
  brand      Brand?  @relation(fields: [brandId], references: [id])
  references WatchReference[]
  watches    Watch[]
  baseCaliberWatches Watch[] @relation("WatchBaseCaliber")
  movementCaliberRepairs     Repair[] @relation("RepairMovementCaliber")
  baseMovementCaliberRepairs Repair[] @relation("RepairBaseMovementCaliber")
  // PartsMaster への複数FK対応：named relation
  parts            PartsMaster[] @relation("PartsCaliber")
  baseCaliberParts PartsMaster[] @relation("PartsBaseCaliber")
  inquiryWatches  InquiryWatch[]
  baseCaliberInquiryWatches InquiryWatch[] @relation("InquiryWatchBaseCaliber")
}

// 3. Repair & Watch
model Watch {
  id           Int      @id @default(autoincrement())
  brandId      Int
  modelId      Int?
  // Customer-entered text from an intake form. It is not a Model master record.
  modelNameInput String?
  referenceId  Int?
  caseReferenceId Int?
  caliberId    Int?
  baseCaliberId Int?
  timepieceType TimepieceType?
  driveType    WatchDriveType?
  serialNumber String? // Optional for vintage/unknown
  customerId   Int
  
  brand       Brand    @relation(fields: [brandId], references: [id])
  model       Model?   @relation(fields: [modelId], references: [id], onDelete: Restrict)
  reference   WatchReference? @relation(fields: [referenceId], references: [id])
  caseReference WatchReference? @relation("WatchCaseReference", fields: [caseReferenceId], references: [id], onDelete: Restrict)
  caliber     Caliber? @relation(fields: [caliberId], references: [id])
  baseCaliber Caliber? @relation("WatchBaseCaliber", fields: [baseCaliberId], references: [id], onDelete: Restrict)
  customer    Customer @relation(fields: [customerId], references: [id])
  repairs     Repair[]
  inquiryWatchPromotion InquiryWatch? @relation("InquiryWatchPromotedWatch")

  accessories  String?  // JSON or comma-separated list of accessories (Box, Warranty, etc.)
  
  // Fast Search Indexes
  @@index([brandId, serialNumber]) // Replaced unique constraint with index
  @@index([serialNumber])
  @@index([brandId, modelId])
}

model RepairIntakeInvite {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  revokedAt  DateTime?
  customerId Int?
  lineUserId Int?
  inquiryId  Int?
  createdAt  DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lineUser LineUser? @relation(fields: [lineUserId], references: [id], onDelete: SetNull)
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  repairs  Repair[]
  inquiryWatches RepairIntakeInviteWatch[]

  @@index([customerId])
  @@index([lineUserId])
  @@index([expiresAt])
  @@index([inquiryId, revokedAt])
}

// The join rows are the immutable, invite-fixed selection for an Inquiry-bound
// B2C intake. Legacy invites deliberately have no rows here.
model RepairIntakeInviteWatch {
  repairIntakeInviteId Int
  inquiryWatchId Int
  createdAt DateTime @default(now())

  repairIntakeInvite RepairIntakeInvite @relation(fields: [repairIntakeInviteId], references: [id], onDelete: Cascade)
  inquiryWatch InquiryWatch @relation(fields: [inquiryWatchId], references: [id], onDelete: Restrict)

  @@id([repairIntakeInviteId, inquiryWatchId])
  @@index([inquiryWatchId])
}

model Repair {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @default(uuid())
  publicToken          String?   @unique
  publicTokenCreatedAt DateTime?
  photoPostingOptOut   Boolean   @default(false)
  inquiryNumber        String    @unique // T-001
  customerId           Int
  watchId              Int
  repairIntakeInviteId Int?
  movementMakerId      Int?
  movementCaliberId    Int?
  baseMovementMakerId  Int?
  baseMovementCaliberId Int?
  partnerRef           String?   // Manual Partner Mgmt No
  accessories          String?   // JSON or CSV of checked items
  
  receptionDate        DateTime? @default(now())
  status               String    // 'reception', 'diagnosing', etc.
  approvalStatus       String    @default("pending")
  // Default safely excludes repairs until a Task166F-aware creation path
  // explicitly opts them into allocation management.
  partsAllocationLegacy Boolean  @default(true)
  approvalDate         DateTime?
  returnRecipientName  String?
  returnPostalCode     String?
  returnPrefecture     String?
  returnCity           String?
  returnStreet         String?
  returnBuilding       String?
  returnPhone          String?
  
  // Scheduling & Priority Logic
  priorityScore        Int       @default(0)
  scheduledDate        DateTime?
  estimatedWorkMinutes Int       @default(0)
  
  workSummary          String?
  internalNotes        String?
  customerNote         String?
  // SEO Flags
  isPublicB2C          Boolean   @default(false)
  isPublicB2B          Boolean   @default(false)
  publicTitle          String?
  publicDescription    String?
  endUserName          String?   // B2B End User Name
  
  
  deliveryDateExpected DateTime?
  deliveryDateActual   DateTime?
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id])
  watch    Watch             @relation(fields: [watchId], references: [id])
  repairIntakeInvite RepairIntakeInvite? @relation(fields: [repairIntakeInviteId], references: [id], onDelete: SetNull)
  movementMaker        Brand?   @relation("RepairMovementMaker", fields: [movementMakerId], references: [id])
  movementCaliber      Caliber? @relation("RepairMovementCaliber", fields: [movementCaliberId], references: [id])
  baseMovementMaker    Brand?   @relation("RepairBaseMovementMaker", fields: [baseMovementMakerId], references: [id])
  baseMovementCaliber  Caliber? @relation("RepairBaseMovementCaliber", fields: [baseMovementCaliberId], references: [id])
  logs          RepairStatusLog[]
  customerMessages RepairCustomerMessage[]
  photos        RepairPhoto[]
  estimate      Estimate?
  repairLineItems RepairLineItem[]
  orderRequests OrderRequest[]
  partAllocations RepairPartAllocation[]
  publicCases   PublicCase[]
  inquiryWatchPromotion InquiryWatch? @relation("InquiryWatchPromotedRepair")
  
  deliveryNoteId Int?
  deliveryNote   DeliveryNote? @relation(fields: [deliveryNoteId], references: [id])

  invoiceId      Int?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])

  estimateDocumentId Int?
  estimateDocument   EstimateDocument? @relation(fields: [estimateDocumentId], references: [id])

  warrantyId Int?
  warranty   Warranty? @relation(fields: [warrantyId], references: [id])

  @@index([repairIntakeInviteId])
}

model RepairStatusLog {
  id        Int      @id @default(autoincrement())
  repairId  Int
  status    String
  changedAt DateTime @default(now())
  changedBy Int?     // Admin ID
  
  repair    Repair   @relation(fields: [repairId], references: [id])
}

model RepairCustomerMessage {
  id        Int       @id @default(autoincrement())
  repairId  Int
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  senderType String    @default("partner")

  repair    Repair    @relation(fields: [repairId], references: [id])

  @@index([repairId, readAt])
}

// 4. Photos
enum RepairPhotoStage {
  RECEPTION
  WORK
  COMPLETION
}

enum RepairPhotoCategory {
  FRONT
  CROWN_SIDE
  BACK
  BRACELET
  MOVEMENT_OPEN
  REPAIR_DETAIL
  OTHER
}

model RepairPhoto {
  id                 Int                 @id @default(autoincrement())
  repairId           Int
  stage              RepairPhotoStage?
  category           RepairPhotoCategory @default(OTHER)
  customerVisible    Boolean             @default(true)
  publicCaseVisible  Boolean             @default(false)
  snsVisible         Boolean             @default(false)
  storageKey         String
  fileName           String?
  mimeType           String?
  createdAt          DateTime            @default(now())
  
  repair             Repair              @relation(fields: [repairId], references: [id])

  @@index([repairId, customerVisible])
  @@index([repairId, publicCaseVisible])
}

// One editable preset per photo category. Applied only when the operator chooses
// a category; existing RepairPhoto rows retain their migrated visibility values.
model PhotoSharingDefault {
  category           RepairPhotoCategory @id
  customerVisible    Boolean
  publicCaseVisible  Boolean
  snsVisible         Boolean
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// 5. Accounting
model PricingRule {
  id                Int     @id @default(autoincrement())
  brandId           Int?
  modelId           Int?
  caliberId         Int?
  customerType      String?
  minPrice          Int
  maxPrice          Int
  suggestedWorkName String
  notes             String?

  repairWorkNameId Int?
  repairWorkName   RepairWorkName? @relation("PricingRuleWorkName", fields: [repairWorkNameId], references: [id])

  repairWorkCategoryId Int?
  repairWorkCategory   RepairWorkCategory? @relation("PricingRuleWorkCategory", fields: [repairWorkCategoryId], references: [id])

  repairWorkActionId Int?
  repairWorkAction   RepairWorkAction? @relation("PricingRuleWorkAction", fields: [repairWorkActionId], references: [id])

  targetPartNameId String?
  targetPartName   PartNameMaster? @relation("PricingRuleTargetPartName", fields: [targetPartNameId], references: [id])

  detailLabel String?

  repairLineItems RepairLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, modelId, caliberId])
  @@index([brandId, customerType])
  @@index([repairWorkNameId])
  @@index([brandId, repairWorkNameId])
  @@index([repairWorkCategoryId])
  @@index([repairWorkActionId])
  @@index([targetPartNameId])
  @@index([repairWorkCategoryId, repairWorkActionId, targetPartNameId])
  @@index([brandId, repairWorkCategoryId, targetPartNameId, repairWorkActionId])
}

model Estimate {
  id             Int      @id @default(autoincrement())
  repairId       Int      @unique
  version        Int      @default(1)
  issuedDate     DateTime @default(now())
  
  technicalFee   Int      @default(0)
  mechanicCost   Int      @default(0)
  partsTotal     Int      @default(0)
  discountAmount Int      @default(0)
  shipping       Int      @default(0)
  taxAmount      Int      @default(0)
  totalAmount    Int      @default(0)
  isActive       Boolean  @default(true)
  
  repair         Repair         @relation(fields: [repairId], references: [id])
  items          EstimateItem[]
}

model EstimateItem {
  // Production Task125 compatibility; structured work remains in RepairLineItem.
  sourceAreaSnapshot     String?
  categoryNameSnapshot   String?
  targetPartNameSnapshot String?
  actionNameSnapshot     String?
  detailLabelSnapshot    String?
  b2cDisplayNameSnapshot String?
  gradeNameSnapshot      String?
  id         Int    @id @default(autoincrement())
  estimateId Int
  itemName   String
  quantity   Int    @default(1)
  unitPrice  Int
  type       String // 'part', 'labor'
  
  // For Parts Management (Phase 3)
  orderStatus String?  @default("pending") // 'pending', 'ordered', 'received'
  orderedAt   DateTime?
  
  partsMasterId Int?
  partsMaster   PartsMaster? @relation(fields: [partsMasterId], references: [id])

  createdAt   DateTime @default(now())

  estimate   Estimate @relation(fields: [estimateId], references: [id])
}

enum RepairLineItemType {
  LABOR
  PART
}

enum RepairWorkType {
  INTERNAL
  EXTERNAL
}

enum RepairWorkReviewStatus {
  APPROVED
  REVIEW
  REJECTED
}

enum RepairWorkSource {
  MANUAL
  USER_INPUT
  FMP
  SEED
}

model RepairLineItem {
  id       Int    @id @default(autoincrement())
  repairId Int
  repair   Repair @relation(fields: [repairId], references: [id], onDelete: Cascade)

  lineType RepairLineItemType

  partsMasterId Int?
  partsMaster   PartsMaster? @relation(fields: [partsMasterId], references: [id])

  pricingRuleId Int?
  pricingRule   PricingRule? @relation(fields: [pricingRuleId], references: [id])

  repairWorkCategoryId Int?
  repairWorkCategory   RepairWorkCategory? @relation("RepairLineItemWorkCategory", fields: [repairWorkCategoryId], references: [id])

  repairWorkActionId Int?
  repairWorkAction   RepairWorkAction? @relation("RepairLineItemWorkAction", fields: [repairWorkActionId], references: [id])

  targetPartNameId String?
  targetPartName   PartNameMaster? @relation("RepairLineItemTargetPartName", fields: [targetPartNameId], references: [id])

  relatedWorkLineItemId Int?
  relatedWorkLineItem   RepairLineItem?  @relation("RepairLineItemRelatedWork", fields: [relatedWorkLineItemId], references: [id])
  relatedPartLineItems  RepairLineItem[] @relation("RepairLineItemRelatedWork")

  itemNameSnapshot            String
  estimateDisplayNameSnapshot String?
  b2bDisplayNameSnapshot      String?
  b2cDisplayNameSnapshot      String?

  gradeNameSnapshot       String?
  notesForCustomerSnapshot String?

  detailLabelSnapshot    String?
  categoryNameSnapshot   String?
  targetPartNameSnapshot String?
  actionNameSnapshot     String?

  quantity  Int @default(1)
  unitPrice Int @default(0)
  amount    Int @default(0)

  showPriceB2b Boolean @default(false)
  showPriceB2c Boolean @default(false)

  sortOrder Int @default(0)

  internalMemo String?
  customerMemo String?
  publicMemo   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repairId])
  @@index([lineType])
  @@index([partsMasterId])
  @@index([pricingRuleId])
  @@index([repairWorkCategoryId])
  @@index([repairWorkActionId])
  @@index([targetPartNameId])
  @@index([repairWorkCategoryId, repairWorkActionId, targetPartNameId])
  @@index([relatedWorkLineItemId])
  @@index([repairId, sortOrder])
  @@index([repairId, lineType])
}

model RepairWorkAction {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  displayName String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workNames   RepairWorkName[]
  repairLineItems RepairLineItem[] @relation("RepairLineItemWorkAction")
  pricingRules PricingRule[] @relation("PricingRuleWorkAction")
}

model RepairWorkCategory {
  id          Int            @id @default(autoincrement())
  repairType  RepairWorkType
  parentId    Int?
  name        String
  displayName String
  description String?
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  parent    RepairWorkCategory?  @relation("RepairWorkCategoryTree", fields: [parentId], references: [id])
  children  RepairWorkCategory[] @relation("RepairWorkCategoryTree")
  workNames RepairWorkName[]
  repairLineItems RepairLineItem[] @relation("RepairLineItemWorkCategory")
  pricingRules PricingRule[] @relation("PricingRuleWorkCategory")

  @@unique([repairType, parentId, name])
  @@index([repairType])
  @@index([parentId])
}

model RepairWorkName {
  id               Int                    @id @default(autoincrement())
  repairType       RepairWorkType
  categoryId       Int
  targetPartNameId String?
  actionId         Int?
  detailLabel      String?
  standardName     String
  b2bDisplayName   String?
  b2cDisplayName   String?
  description      String?
  sortOrder        Int                    @default(0)
  isActive         Boolean                @default(true)
  source           RepairWorkSource       @default(MANUAL)
  reviewStatus     RepairWorkReviewStatus @default(APPROVED)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  category       RepairWorkCategory @relation(fields: [categoryId], references: [id])
  targetPartName PartNameMaster?    @relation(fields: [targetPartNameId], references: [id])
  action         RepairWorkAction?   @relation(fields: [actionId], references: [id])
  pricingRules   PricingRule[]      @relation("PricingRuleWorkName")

  @@index([repairType])
  @@index([categoryId])
  @@index([targetPartNameId])
  @@index([actionId])
  @@index([reviewStatus])
}

// 6. Parts

// §13 購入店マスタ
model Supplier {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  url      String?
  isOnline Boolean @default(true) // true: オンライン店 / false: 実店舗
  notes    String?

  parts         PartsMaster[]
  orderRequests OrderRequest[]
}

// §13 部品マスタ（内装・外装統合）
// Standard part category master for selectable part categories.
model PartCategoryMaster {
  id        String   @id @default(cuid())
  key       String   @unique
  partType  String
  nameJa    String
  nameEn    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  partNames PartNameMaster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partType])
  @@index([partType, sortOrder])
}

// Standard part name master. Prices, stock, suppliers, and refs belong to PartsMaster.
model PartNameMaster {
  id         String   @id @default(cuid())
  key        String   @unique
  categoryId String
  partType   String

  nameJa     String
  nameEn     String?
  displayJa  String?
  displayEn  String?

  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)

  category   PartCategoryMaster @relation(fields: [categoryId], references: [id])
  parts      PartsMaster[]
  repairWorkNames RepairWorkName[]
  repairLineItems RepairLineItem[] @relation("RepairLineItemTargetPartName")
  pricingRules PricingRule[] @relation("PricingRuleTargetPartName")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([partType])
  @@index([categoryId])
  @@index([partType, categoryId])
  @@index([partType, sortOrder])
}

// Grade master. Genuine/FIT/custom-fit can imply different price, quality, supplier, and stock.
model PartGradeMaster {
  id        String   @id @default(cuid())
  key       String   @unique
  nameJa    String
  nameEn    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  parts     PartsMaster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model PartsMaster {
  id              Int     @id @default(autoincrement())
  standardPartNameId String?
  gradeId            String?

  // ── 区分 ──────────────────────────────────
  partType        String? // 'interior'（内装）| 'exterior'（外装）/ nullable for existing rows
  category        String  // 'internal', 'external', 'generic'（既存互換）
  subcategory     String? // 内装サブカテゴリ: '地板/受け'|'輪列'|'巻上'|'調速'|'裏まわり'

  // ── 外装：時計情報 ────────────────────────
  brandId         Int?
  modelId         Int?
  watchRefs       String? // 対応Ref（カンマ区切り）

  // ── 内装：ムーブメント情報 ─────────────────
  caliberId       Int?    // Cal.
  baseCaliberId   Int?    // ベースムーブメントCal.
  movementMakerId Int?    // ムーブメント製造元（brandIdと異なる場合）
  baseMakerId     Int?    // ベースムーブメント製造元

  // ── 部品情報 ──────────────────────────────
  name            String  // Legacy
  nameEn          String? @map("name_en")
  nameJp          String  @map("name_jp")
  partRefs        String? // 部品Ref（カンマ区切り複数対応）
  cousinsNumber   String? // cousins番号
  grade           String? // '純正' | 'FIT' | '合わせ'
  size            String? // サイズ（外装用・カテゴリごとテンプレ）
  photoKey        String? // 画像キー

  // ── 備考 ──────────────────────────────────
  notes1          String? @map("notes") // 備考1（既存DBカラム名保持）
  notes2          String? // 備考2

  // ── 価格情報 ──────────────────────────────
  costCurrency    String  @default("JPY") // ¥ / £ / $ / €
  costOriginal    Float   @default(0)     // 外貨建て仕入原価
  latestCostYen   Int     @default(0)     // 円換算仕入価格
  markupRate      Float   @default(1.3)   // 掛け率 1.1〜2.0
  retailPrice     Int     @default(0)     // 上代（500円単位切り上げ）

  // ── 在庫情報 ──────────────────────────────
  stockQuantity        Int     @default(0)
  minStockAlert        Int     @default(0)     // 最小在庫数アラートしきい値
  minStockAlertEnabled Boolean @default(false) // アラートON/OFF
  location             String? // 保管場所（例：A-3-2）
  supplierId           Int?    // FK → Supplier

  // ── Relations ────────────────────────────
  brand         Brand?    @relation("PartsBrand",         fields: [brandId],         references: [id])
  model         Model?    @relation(                      fields: [modelId],          references: [id])
  caliber       Caliber?  @relation("PartsCaliber",       fields: [caliberId],        references: [id])
  baseCaliber   Caliber?  @relation("PartsBaseCaliber",   fields: [baseCaliberId],    references: [id])
  movementMaker Brand?    @relation("PartsMovementMaker", fields: [movementMakerId],  references: [id])
  baseMaker     Brand?    @relation("PartsBaseMaker",     fields: [baseMakerId],      references: [id])
  supplier      Supplier? @relation(                      fields: [supplierId],        references: [id])
  standardPartName PartNameMaster?  @relation(fields: [standardPartNameId], references: [id])
  gradeMaster      PartGradeMaster? @relation(fields: [gradeId],            references: [id])
  orderRequests OrderRequest[]
  repairPartAllocations RepairPartAllocation[]
  estimateItems EstimateItem[]
  repairLineItems RepairLineItem[]

  @@index([standardPartNameId])
  @@index([gradeId])
}

enum RepairPartAllocationState {
  RESERVED
  CONSUMED
  RELEASED
}

// Repair-specific inventory reservation. PartsMaster.stockQuantity is the
// unreserved physical stock; this record is the durable allocation ledger.
model RepairPartAllocation {
  id            Int                       @id @default(autoincrement())
  repairId      Int
  partsMasterId Int
  quantity      Int
  state         RepairPartAllocationState @default(RESERVED)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  releasedAt    DateTime?

  repair      Repair      @relation(fields: [repairId], references: [id], onDelete: Cascade)
  partsMaster PartsMaster @relation(fields: [partsMasterId], references: [id])

  @@unique([repairId, partsMasterId])
  @@index([repairId, state])
  @@index([partsMasterId, state])
}

// 7. Documents (Bulk Generation)
model DeliveryNote {
  id           Int      @id @default(autoincrement())
  slipNumber   String   @unique // e.g. TD-001
  issuedDate   DateTime @default(now())
  
  customerId   Int
  customer     Customer @relation(fields: [customerId], references: [id])
  
  repairs      Repair[]
  
  totalAmount  Int      @default(0) // Cache for speed
  taxAmount    Int      @default(0)
}

model Invoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique // e.g. TI-001
  issuedDate    DateTime @default(now())
  billingMonth  String?
  publicToken   String?  @unique
  publicTokenCreatedAt DateTime?
  currentPdfFileId Int? @unique
  
  customerId    Int
  customer      Customer @relation(fields: [customerId], references: [id])
  
  repairs       Repair[]
  repairSnapshots InvoiceRepairSnapshot[]
  paymentAllocations PaymentAllocation[]
  pdfFiles      InvoicePdfFile[] @relation("InvoicePdfFiles")
  currentPdfFile InvoicePdfFile? @relation("CurrentInvoicePdfFile", fields: [currentPdfFileId], references: [id], onDelete: SetNull)
  
  totalAmount   Int      @default(0) // Issued pre-tax subtotal, integer JPY (existing meaning)
  taxAmount     Int      @default(0) // Issued tax, integer JPY
  grossTotalAmount Int   // Issued payable total; INSERT trigger fills NULL for old writers
  status        String   @default("issued") // issued, paid
  paymentDueDate DateTime?
  sentAt        DateTime?
}

// Immutable per-repair amounts and delivery details captured when an Invoice is issued.
// New invoice rendering must use these rows rather than the editable EstimateItem rows.
model InvoiceRepairSnapshot {
  id                Int      @id @default(autoincrement())
  invoiceId         Int
  repairId          Int
  inquiryNumber     String
  deliveryNoteId    Int?
  deliverySlipNumber String?
  deliveryIssuedDate DateTime?
  deliveryDateActual DateTime?
  subtotalAmount    Int
  createdAt         DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, repairId])
  @@index([repairId])
  @@index([invoiceId, deliveryNoteId])
}

enum PaymentProvider {
  STRIPE
  MANUAL
}

enum PaymentMethod {
  CARD
  PAYPAY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

// A receipt or payment-in-progress. Its allocations determine which invoices it settles.
model Payment {
  id         Int             @id @default(autoincrement())
  customerId Int
  amount     Int
  currency   String          @default("JPY")
  provider   PaymentProvider
  method     PaymentMethod?
  status     PaymentStatus   @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  customer    Customer            @relation(fields: [customerId], references: [id])
  allocations PaymentAllocation[]
  attempts    PaymentAttempt[]

  @@index([customerId, status])
  @@index([status, paidAt])
}

model PaymentAllocation {
  id              Int      @id @default(autoincrement())
  paymentId       Int      @unique
  invoiceId       Int
  allocatedAmount Int
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

// Provider-specific attempts are separate because one Payment can require retries.
model PaymentAttempt {
  id                    Int                  @id @default(autoincrement())
  paymentId             Int
  provider              PaymentProvider
  status                PaymentAttemptStatus @default(PENDING)
  idempotencyKey        String               @unique
  externalTransactionId String?              @unique
  checkoutSessionId     String?              @unique
  paymentIntentId       String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, status])
}



model EstimateDocument {
  id              Int      @id @default(autoincrement())
  estimateNumber  String   @unique // e.g. TE-001
  issuedDate      DateTime @default(now())
  publicToken     String?  @unique
  publicTokenCreatedAt DateTime?
  currentPdfFileId Int?    @unique
  
  customerId      Int
  customer        Customer @relation(fields: [customerId], references: [id])

  repairs         Repair[]
  pdfFiles        EstimatePdfFile[] @relation("EstimateDocumentPdfFiles")
  currentPdfFile  EstimatePdfFile?  @relation("CurrentEstimatePdfFile", fields: [currentPdfFileId], references: [id], onDelete: SetNull)

  totalAmount     Int      @default(0)
  taxAmount       Int      @default(0)
}

model EstimatePdfFile {
  id                 Int              @id @default(autoincrement())
  estimateDocumentId Int
  customerId         Int?
  storageKey         String
  fileName           String
  contentType        String           @default("application/pdf")
  fileSize           Int?
  hash               String?
  version            Int
  status             String           @default("current")
  generatedAt        DateTime         @default(now())
  generatedBy        String?
  sentAt             DateTime?
  approvedAt         DateTime?
  supersededAt       DateTime?

  estimateDocument   EstimateDocument  @relation("EstimateDocumentPdfFiles", fields: [estimateDocumentId], references: [id], onDelete: Cascade)
  currentForDocument EstimateDocument? @relation("CurrentEstimatePdfFile")
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([estimateDocumentId])
  @@index([customerId])
  @@index([status])
  @@unique([estimateDocumentId, version])
}

model InvoicePdfFile {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice Invoice @relation("InvoicePdfFiles", fields: [invoiceId], references: [id], onDelete: Cascade)

  currentForInvoice Invoice? @relation("CurrentInvoicePdfFile")

  customerId Int?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  storageKey String
  fileName String
  contentType String @default("application/pdf")
  fileSize Int?
  hash String?

  version Int
  status String @default("draft")

  generatedAt DateTime @default(now())
  generatedBy String?

  sentAt DateTime?
  paidAt DateTime?
  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([invoiceId, version])
  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
}

model Warranty {
  id              Int      @id @default(autoincrement())
  warrantyNumber  String   @unique // e.g. TW-001
  issuedDate      DateTime @default(now())
  guaranteeStart  DateTime
  guaranteeEnd    DateTime

  customerId      Int
  customer        Customer @relation(fields: [customerId], references: [id])

  repairs         Repair[]
}

// §21 発注リスト
model OrderRequest {
  id            Int      @id @default(autoincrement())

  // 部品情報
  partsMasterId Int?
  partsMaster   PartsMaster? @relation(fields: [partsMasterId], references: [id])
  partNameJp    String
  partNameEn    String?
  partRefs      String?
  cousinsNumber String?

  // 発注情報
  quantity      Int      @default(1)
  supplierId    Int?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])

  // ステータス
  // pending（未発注）/ ordered（注文済み）/ received（入荷済み）/ cancelled（キャンセル）
  status        String   @default("pending")

  // 検索ワード（自動生成）
  searchWordJp  String?
  searchWordEn  String?

  // 関連カルテ
  repairId      Int?
  repair        Repair?  @relation(fields: [repairId], references: [id])

  // メモ・日時
  notes         String?
  orderedAt     DateTime?
  receivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum PublicCaseSourceType {
  FMP
  WEB_APP
}

enum PublicCasePublishStatus {
  HIDDEN
  READY
  PUBLISHED
  ARCHIVED
}

enum PublicCaseReviewStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum PublicCaseWarningSeverity {
  CRITICAL
  REVIEW
  INFO
}

model PublicCase {
  id             Int                  @id @default(autoincrement())
  sourceType     PublicCaseSourceType
  sourceRepairId String?
  repairId       Int?

  receivedDate DateTime?
  brandName    String?
  brandNameKana String?
  brandDisplayName String?
  modelName    String?
  ref          String?
  caliber      String?
  searchText   String?

  reviewStatus     PublicCaseReviewStatus @default(DRAFT)
  b2bPublishStatus PublicCasePublishStatus @default(HIDDEN)
  b2cPublishStatus PublicCasePublishStatus @default(HIDDEN)
  b2bPublishedAt   DateTime?
  b2cPublishedAt   DateTime?

  b2bTitle   String?
  b2cTitle   String?
  b2bSummary Json?
  b2cSummary Json?
  publicTags Json?

  showPriceB2b       Boolean @default(true)
  showPriceB2c       Boolean @default(false)
  internalLaborTotal Int?
  externalLaborTotal Int?
  outsourcedTotal    Int?
  partsTotal         Int?
  totalAmount        Int?

  warnings       Json?
  excludeReasons Json?
  sourceSnapshot Json?

  repair       Repair?              @relation(fields: [repairId], references: [id], onDelete: SetNull)
  workItems    PublicCaseWorkItem[]
  partItems    PublicCasePartItem[]
  images       PublicCaseImage[]
  warningItems PublicCaseWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceType, sourceRepairId])
  @@index([repairId])
  @@index([brandName])
  @@index([brandNameKana])
  @@index([modelName])
  @@index([ref])
  @@index([caliber])
  @@index([b2bPublishStatus])
  @@index([b2cPublishStatus])
  @@index([reviewStatus])
}

model PublicCaseWorkItem {
  id           Int @id @default(autoincrement())
  publicCaseId Int

  sourceArea           String
  sourceSlot           Int?
  sourceText           String
  normalizedSourceText String

  isRuleMatched Boolean                @default(false)
  isPublishable Boolean                @default(false)
  reviewStatus  PublicCaseReviewStatus @default(DRAFT)
  excludeReason String?

  normalizedWorkName String?
  b2bDisplayName     String?
  b2cDisplayName     String?
  laborPrice         Int?
  showPriceB2b       Boolean @default(true)
  showPriceB2c       Boolean @default(false)

  category     String?
  partName     String?
  action       String?
  actionDetail String?
  attributes   Json?
  ruleSnapshot Json?

  sortOrder Int @default(0)

  publicCase PublicCase           @relation(fields: [publicCaseId], references: [id], onDelete: Cascade)
  partItems  PublicCasePartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicCaseId])
  @@index([sourceArea])
  @@index([normalizedSourceText])
  @@index([isPublishable])
}

model PublicCasePartItem {
  id                Int  @id @default(autoincrement())
  publicCaseId      Int
  relatedWorkItemId Int?

  sourceArea           String
  sourceSlot           Int?
  sourceText           String
  normalizedSourceText String
  displayName          String?
  price                Int?

  showPriceB2b   Boolean                @default(true)
  showPriceB2c   Boolean                @default(false)
  relationStatus String                 @default("UNLINKED")
  reviewStatus   PublicCaseReviewStatus @default(DRAFT)
  excludeReason  String?
  metadata       Json?

  sortOrder Int @default(0)

  publicCase      PublicCase          @relation(fields: [publicCaseId], references: [id], onDelete: Cascade)
  relatedWorkItem PublicCaseWorkItem? @relation(fields: [relatedWorkItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicCaseId])
  @@index([relatedWorkItemId])
  @@index([sourceArea])
}

model PublicCaseImage {
  id           Int @id @default(autoincrement())
